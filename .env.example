# Copie este arquivo para .env e preencha UMA das chaves abaixo.
# O .env nunca vai para o GitHub (está no .gitignore).

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional: escolher o provedor e o modelo.
# ACTA_PROVIDER=openai          # ou anthropic
# ACTA_MODEL=gpt-5.4-mini       # ou claude-haiku-5-5
